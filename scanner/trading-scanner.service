# systemd služba pro nepřetržitý běh (Linux server / Raspberry Pi).
# Instalace: viz scanner/README.md
[Unit]
Description=trading-team rychlý skener (bez AI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/home/trader/trading-team
# TELEGRAM_BOT_TOKEN=... a TELEGRAM_CHAT_ID=... (soubor necommitovat, chmod 600)
EnvironmentFile=/home/trader/trading-team/.env
ExecStart=/home/trader/trading-team/.venv/bin/python scanner/scan.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
